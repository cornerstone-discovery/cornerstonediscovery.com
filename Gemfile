source "https://rubygems.org"

# Built by .github/workflows/pages.yml (GitHub's standard Jekyll workflow), not the
# legacy github-pages gem, so _plugins/ runs and the site can preview under a sub-path.
gem "jekyll", "~> 4.3"
gem "kramdown-parser-gfm"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
  gem "jekyll-redirect-from"
end

# Local `bundle exec jekyll serve`
gem "webrick"
gem "tzinfo-data", platforms: [:windows, :jruby]
